"""Tests for rules_external_secrets.

- Analysis test verifies the macro instantiates cleanly.
- Smoke composition: kind cluster + ESO + a SecretStore (fake provider
  with a baked unique payload) + an ExternalSecret. Smoke waits for the
  resulting K8s Secret, decodes it, asserts the payload round-trips —
  proves the operator's reconciler + SecretStore resolution + data sync
  all work.
"""

load("@rules_external_secrets//:defs.bzl", "external_secrets_health_check", "external_secrets_install")
load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":analysis_tests.bzl", "external_secrets_install_test_suite")

# ---- analysis ---------------------------------------------------------------

external_secrets_install_test_suite(name = "external_secrets_install_analysis")

# ---- smoke composition ------------------------------------------------------

kind_cluster(name = "cluster", k8s_version = "1.35")
kind_health_check(name = "cluster_health", cluster = ":cluster")
itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    tags = ["manual"],
)

external_secrets_install(
    name = "eso_install_bin",
    tags = ["manual"],
)

external_secrets_health_check(
    name = "eso_health_bin",
    tags = ["manual"],
)

sh_binary(
    name = "eso_install_wrapper",
    srcs = ["install_wrapper.sh"],
    data = [":eso_install_bin"],
)

sh_binary(
    name = "eso_health_wrapper",
    srcs = ["health_wrapper.sh"],
    data = [":eso_health_bin"],
)

itest_service(
    name = "eso_svc",
    exe = ":eso_install_wrapper",
    deps = [":kind_svc"],
    health_check = ":eso_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":eso_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)
